---
# ══════════════════════════════════════════════════════════════════════
# Ansible Vault Secrets – EXAMPLE FILE (DO NOT COMMIT WITH REAL VALUES)
#
# WORKFLOW:
#   1. Copy to secrets.yml:  cp secrets.yml.example secrets.yml
#   2. Fill real values below
#   3. Encrypt:              ansible-vault encrypt ansible/vault/secrets.yml
#   4. Edit later:           ansible-vault edit ansible/vault/secrets.yml
#   5. Store vault password in K8s:
#        kubectl create secret generic ansible-vault-password \
#          --from-literal=vault-password=YOUR_VAULT_PASSWORD \
#          -n ansible-jobs-dev
#
# secrets.yml is in .gitignore — only the encrypted version should be committed
# ══════════════════════════════════════════════════════════════════════

vault_db_password: "CHANGE_ME"
vault_api_key: "CHANGE_ME"
vault_ssh_passphrase: "CHANGE_ME"
