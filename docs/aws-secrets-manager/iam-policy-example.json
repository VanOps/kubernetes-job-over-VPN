{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAnsibleVPNSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:eu-west-1:*:secret:ansible-vpn/prod/*"
      ]
    },
    {
      "Sid": "ListSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:ListSecrets"],
      "Resource": "*"
    }
  ]
}
