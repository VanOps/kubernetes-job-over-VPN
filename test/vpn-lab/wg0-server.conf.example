# ══════════════════════════════════════════════════════════════════════
# WireGuard Server Config Example — TEST LAB ONLY
#
# This file is auto-generated by test/vpn-lab/setup.sh.
# Do NOT fill this example manually — run setup.sh instead.
#
# Topology:
#   wg0 server IP  : 10.10.99.1/24  (VPN virtual network)
#   wg0 client IP  : 10.10.99.2/24  (Ansible sidecar)
#   backend subnet : 10.10.20.0/24  (where remote-host lives at .10)
# ══════════════════════════════════════════════════════════════════════
[Interface]
PrivateKey = SERVER_PRIVATE_KEY_BASE64
Address    = 10.10.99.1/24
ListenPort = 51820

# MASQUERADE traffic from VPN clients going to the backend network
PostUp   = iptables -A FORWARD -i wg0 -j ACCEPT; \
           iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT; \
           iptables -t nat -A POSTROUTING -s 10.10.99.0/24 ! -o wg0 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; \
           iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT; \
           iptables -t nat -D POSTROUTING -s 10.10.99.0/24 ! -o wg0 -j MASQUERADE

[Peer]
# Ansible Job WireGuard client (sidecar)
PublicKey  = CLIENT_PUBLIC_KEY_BASE64
AllowedIPs = 10.10.99.2/32
