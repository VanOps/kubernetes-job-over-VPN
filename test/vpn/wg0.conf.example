# ══════════════════════════════════════════════════════════════════════
# WireGuard Client Config Example
#
# LOCAL VPN LAB: do NOT fill this file manually.
#   Run  bash test/vpn-lab/setup.sh  — it writes test/vpn/wg0.conf
#   automatically with matching keys and the correct endpoint.
#
# REAL VPN SERVER: copy to test/vpn/wg0.conf, fill values, SKIP_VPN=false.
# ══════════════════════════════════════════════════════════════════════
[Interface]
# Client private key (generate: wg genkey)
PrivateKey = CLIENT_PRIVATE_KEY_BASE64
# VPN client IP assigned by the server admin
Address = 10.10.99.2/24

[Peer]
# VPN server public key
PublicKey = SERVER_PUBLIC_KEY_BASE64
# For the local lab: Endpoint = vpn-server:51820 (Docker DNS name)
# For a real server: use its public IP or hostname
Endpoint = vpn.example.com:51820
# VPN subnet + private subnets behind the VPN
AllowedIPs = 10.10.99.0/24, 10.10.20.0/24
PersistentKeepalive = 25
